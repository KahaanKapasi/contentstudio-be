# Copy to backend/.env (local) or set as environment variables (Render). Never commit real values.

# --- Persistence ---
# Leave blank locally to use the SQLite file in storage/. In production set a Postgres URL
# (Neon etc.) — postgres:// and postgresql:// are accepted as-is. Render's free disk is
# ephemeral, so SQLite there is wiped on every deploy/restart.
DATABASE_URL=

# --- Access gate ---
# When set, every API route (except /api/health and /api/auth/status) requires the header
# X-Access-Password: <this value>, and the web app shows a password prompt. Set this on any
# public deployment.
LOCAL_ACCESS_PASSWORD=

# --- Gemini (Discovery topics, Articles, Video titles/scripts, Twitter suggestions, match-day opinions) ---
GEMINI_API_KEY=

# --- Instagram Graph API (Dashboard stats + Posts publishing) ---
IG_BUSINESS_ACCOUNT_ID=
IG_ACCESS_TOKEN=
IG_PAGE_ID=

# --- X / Twitter (Discovery source, Dashboard stats, posting) ---
X_BEARER_TOKEN=
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# --- Cloudinary (Instagram needs a public image URL to publish) ---
CLOUDINARY_URL=
